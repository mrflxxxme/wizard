# BETA shape (managed PostgreSQL; the pilot is terraform.tfvars.example). Copy to the runner (WIZARD_TFVARS_FILE, default /etc/wizard/terraform-prod.tfvars). Not committed.
# Beta prod within ≤ 30 000 ₽/month: k3s server (platform) + one gVisor sandbox agent, single managed PostgreSQL.
settings = {
  server          = { cpu = 4, ram_gb = 8, disk_gb = 100 }
  sandbox_nodes   = { free = { cpu = 4, ram_gb = 8, disk_gb = 50 } }
  postgres        = { cpu = 2, ram_gb = 4, disk_gb = 40, backup_copies = 14 }
  ssh_public_key  = "ssh-ed25519 AAAA... wizard-runner"
  admin_cidrs     = ["192.0.2.10/32"]
  platform_domain = "<codename>.ru"
  systems_domain  = "<neutral systems domain>"
}
