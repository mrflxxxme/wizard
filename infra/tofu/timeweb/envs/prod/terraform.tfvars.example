# Copy to the runner (WIZARD_TFVARS_FILE, default /etc/wizard/terraform-prod.tfvars). Not committed.
# PILOT prod (founder decision 2026-10-01; docs/ops/deploy.md «Пилот»): ONE VM in Moscow with single-node k3s running
# everything, PostgreSQL 16 + WAL-G inside the cluster (postgres = null), buckets files + backups.
# Cloud MSK 80 (4 vCPU / 8 GB / 80 GB NVMe) ≈ 1 800 ₽/month: max_price is the ceiling of the preset search — a plan
# that needs a dearer preset fails instead of raising the bill. The beta shape: terraform.tfvars.beta.example.
settings = {
  server          = { cpu = 4, ram_gb = 8, disk_gb = 80, max_price = 2000 }
  sandbox_nodes   = {}
  postgres        = null
  buckets         = { files = 10, backups = 100 }
  image_registry  = "ghcr.io/<github owner, lower case>"
  ssh_public_key  = "ssh-ed25519 AAAA... wizard-runner"
  admin_cidrs     = ["192.0.2.10/32"] # runner VM / founder
  platform_domain = "<codename>.ru"
  systems_domain  = "<neutral systems domain>"
}
