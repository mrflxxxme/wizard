# Copy to the runner (WIZARD_TFVARS_FILE, default /etc/wizard/terraform-staging.tfvars). Not committed.
# Staging on demand: one VM runs k3s, the platform and the gVisor sandbox pool. Rough price: docs/ops/deploy.md.
settings = {
  location        = "ru-1"
  server          = { cpu = 4, ram_gb = 8, disk_gb = 80 }
  sandbox_nodes   = {}
  postgres        = { cpu = 1, ram_gb = 2, disk_gb = 20, backup_copies = 3 }
  ssh_public_key  = "ssh-ed25519 AAAA... wizard-runner"
  admin_cidrs     = ["192.0.2.10/32"] # runner VM / founder
  platform_domain = "<staging platform domain>"
  systems_domain  = "<staging systems domain>"
}
