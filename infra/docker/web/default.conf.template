# Rendered by the nginx entrypoint (envsubst of defined variables only): ${WIZARD_SYSTEMS_DOMAIN}.
# CSP = apps/platform-web/src/csp.ts platformCsp({frameSrc: systemsFrameSrc(domain)}) — tools/deploy test keeps them equal.
server {
    listen 8080;
    server_tokens off;
    root /usr/share/nginx/html;
    charset utf-8;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # Hashed bundles: immutable for a year.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; frame-src https://*.${WIZARD_SYSTEMS_DOMAIN}; object-src 'none'; base-uri 'none'" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # SPA: unknown paths → index.html, never cached.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; frame-src https://*.${WIZARD_SYSTEMS_DOMAIN}; object-src 'none'; base-uri 'none'" always;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
