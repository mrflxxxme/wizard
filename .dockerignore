.git
.github
.claude
**/.omc
.data
.env
.env.*
!.env.example
**/*.log
**/dist
**/test-results
**/playwright-report
tools/eval/results
infra/tofu/**/.terraform
infra/tofu/**/*.tfstate*
infra/tofu/**/*.tfvars
docs
