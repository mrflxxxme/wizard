{
  "compilerOptions": {
    "strict": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "@wizard/sdk",
    "noEmit": true,
    "types": [],
    "skipLibCheck": true,
    "paths": {
      "@wizard/sdk": ["../sdk/src/sdk.d.ts"],
      "@wizard/sdk/jsx-runtime": ["../sdk/src/jsx-runtime.ts"],
      "@wizard/ui-kit": ["../ui-kit/src/ui-kit.d.ts"]
    }
  }
}
