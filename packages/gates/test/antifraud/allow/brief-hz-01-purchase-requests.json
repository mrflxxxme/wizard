    "ui/Main.tsx": "import { AppShell, Button, ConsentCheckbox, Field } from \"@wizard/ui-kit\";\nimport { useEntityMutation, useState } from \"@wizard/sdk\";\n\nexport default function Main() {\n  const [form, setForm] = useState({ name: \"\", phone: \"\", consent: false });\n  const requests = useEntityMutation(\"request\");\n  return (\n    <AppShell title={\"Внутренние заявки на закупку с согласованием\"}>\n      <p>{\"Компания на 60 сотрудников, три отдела. Нужен внутренний сервис заявок на закупку: сотрудник создаёт заявку — что купить, количество, ориентировочная цена, ссылка или файл счёта от поставщика, срочность, обоснование. Заявка до 30 000 ₽ согласуется руководителем отдела, дороже — ещё и финансовым директором. Согласующий может одобрить, отклонить или вернуть на доработку с комментарием. После одобрения закупщик берёт заявку в работу, прикладывает итоговый счёт и отмечает оплату и получение. У каждого отдела месячный бюджет, при превышении система предупреждает и требует согласования финдиректора. Уведомления о новых задачах — в Telegram. Отчёт: расходы по отделам и категориям за месяц, среднее время согласования. Сейчас заявки вручную сводит помощник финдиректора клиент, срочные он принимает в Telegram клиент.\"}</p>\n      <ul>\n        <li>{\"Порог 30 000 ₽\"}</li>\n        <li>{\"Многоступенчатое согласование\"}</li>\n        <li>{\"Возврат на доработку\"}</li>\n        <li>{\"Вложение счёта\"}</li>\n        <li>{\"Бюджет отдела и превышение\"}</li>\n        <li>{\"Отметка оплаты и получения\"}</li>\n        <li>{\"Уведомления в Telegram\"}</li>\n        <li>{\"Отчёт по расходам и времени согласования\"}</li>\n      </ul>\n      <p>{\"Заявка дороже 30 000 ₽ требует согласования финдиректора\"}</p>\n      <p>{\"Превышение бюджета отдела требует согласования финдиректора\"}</p>\n      <p>{\"Сотрудник видит только свои заявки\"}</p>\n      <p>{\"Отклонённая заявка не попадает к закупщику\"}</p>\n      <form onSubmit={(e) => { e.preventDefault(); void requests.create({ contact_name: form.name, contact_phone: form.phone }, { consent: true }); }}>\n        <Field name=\"contact_name\" label=\"Имя\" type=\"string\" value={form.name} onChange={(v) => setForm({ ...form, name: String(v) })} />\n        <Field name=\"contact_phone\" label=\"Телефон\" type=\"phone\" value={form.phone} onChange={(v) => setForm({ ...form, phone: String(v) })} />\n        <ConsentCheckbox checked={form.consent} onChange={(v) => setForm({ ...form, consent: v })} />\n        <Button type=\"submit\">{\"Отправить заявку\"}</Button>\n      </form>\n    </AppShell>\n  );\n}\n"
  }
