    "ui/Main.tsx": "import { AppShell, Button, ConsentCheckbox, Field } from \"@wizard/ui-kit\";\nimport { useEntityMutation, useState } from \"@wizard/sdk\";\n\nexport default function Main() {\n  const [form, setForm] = useState({ name: \"\", phone: \"\", consent: false });\n  const requests = useEntityMutation(\"request\");\n  return (\n    <AppShell title={\"Мини-CRM студии: заявки, сделки и задачи менеджеров\"}>\n      <p>{\"Мы небольшая студия интерьерного дизайна, пять менеджеров и два дизайнера. Заявки приходят с сайта, из Telegram и по звонкам, сейчас всё теряется в переписке. Нужна простая CRM: карточка клиента (компания или частное лицо, контакты, источник), сделки с этапами «новая», «встреча», «коммерческое предложение», «договор», «в работе», «закрыта» или «отказ» с причиной. У сделки есть сумма, ответственный менеджер и следующий шаг с датой; если дата прошла, менеджер получает напоминание. Менеджер видит только свои сделки, руководитель — все и может передать сделку другому менеджеру. К сделке прикладываем файлы: бриф клиента, КП, договор. Дизайнеры видят сделки на этапе «в работе» и ставят себе задачи. Нужна воронка по этапам и отчёт по источникам заявок и причинам отказов за месяц.\"}</p>\n      <ul>\n        <li>{\"Этапы сделки\"}</li>\n        <li>{\"Причина отказа\"}</li>\n        <li>{\"Следующий шаг с датой\"}</li>\n        <li>{\"Напоминание о просроченном шаге\"}</li>\n        <li>{\"Передача сделки другому менеджеру\"}</li>\n        <li>{\"Вложения к сделке\"}</li>\n        <li>{\"Воронка\"}</li>\n        <li>{\"Отчёт по источникам и отказам\"}</li>\n      </ul>\n      <p>{\"Менеджер видит только свои сделки\"}</p>\n      <p>{\"Руководитель может передать сделку\"}</p>\n      <p>{\"Закрытие с отказом требует причины\"}</p>\n      <p>{\"Просроченный следующий шаг даёт напоминание\"}</p>\n      <form onSubmit={(e) => { e.preventDefault(); void requests.create({ contact_name: form.name, contact_phone: form.phone }, { consent: true }); }}>\n        <Field name=\"contact_name\" label=\"Имя\" type=\"string\" value={form.name} onChange={(v) => setForm({ ...form, name: String(v) })} />\n        <Field name=\"contact_phone\" label=\"Телефон\" type=\"phone\" value={form.phone} onChange={(v) => setForm({ ...form, phone: String(v) })} />\n        <ConsentCheckbox checked={form.consent} onChange={(v) => setForm({ ...form, consent: v })} />\n        <Button type=\"submit\">{\"Отправить заявку\"}</Button>\n      </form>\n    </AppShell>\n  );\n}\n"
  }
