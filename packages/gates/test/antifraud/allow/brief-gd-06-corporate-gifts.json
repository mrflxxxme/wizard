    "ui/Main.tsx": "import { AppShell, Button, ConsentCheckbox, Field } from \"@wizard/ui-kit\";\nimport { useEntityMutation, useState } from \"@wizard/sdk\";\n\nexport default function Main() {\n  const [form, setForm] = useState({ name: \"\", phone: \"\", consent: false });\n  const requests = useEntityMutation(\"request\");\n  return (\n    <AppShell title={\"Корпоративные подарки с логотипом: тираж, макет, производство к дате\"}>\n      <p>{\"Мастерская корпоративных подарков: кружки, термосы, блокноты, худи с нанесением логотипа (печать, гравировка, вышивка). Клиенты — компании, заказывают к праздникам тиражи от 20 до 2000 штук. Нужен B2B-сервис: менеджер компании-клиента регистрируется, выбирает изделия из каталога, способ нанесения, цвет и тираж, загружает логотип в векторе. Цена считается по таблице: базовая цена изделия, нанесение по числу цветов, скидка от тиража. Для каждого способа нанесения есть минимальный тираж. Наш дизайнер готовит макет, клиент утверждает его в кабинете или оставляет правки; производство начинается только после утверждения макета и предоплаты половины суммы по счёту. Срок производства зависит от тиража; если клиент просит дату раньше возможной, система предупреждает и предлагает срочность с наценкой 30 %. Производство отмечает этапы: закупка заготовок, нанесение, упаковка, готов к отгрузке. Клиент видит только заказы своей компании. Отчёт: загрузка производства по неделям и выручка по способам нанесения. Срочные заказы координирует клиент, её канал в Telegram клиент.\"}</p>\n      <ul>\n        <li>{\"Расчёт цены по таблице\"}</li>\n        <li>{\"Скидка от тиража\"}</li>\n        <li>{\"Минимальный тираж\"}</li>\n        <li>{\"Загрузка логотипа\"}</li>\n        <li>{\"Утверждение макета\"}</li>\n        <li>{\"Предоплата по счёту\"}</li>\n        <li>{\"Наценка за срочность\"}</li>\n        <li>{\"Этапы производства\"}</li>\n      </ul>\n      <p>{\"Производство не начинается без утверждённого макета и предоплаты\"}</p>\n      <p>{\"Тираж меньше минимального нельзя оформить\"}</p>\n      <p>{\"Ранняя дата требует срочности с наценкой\"}</p>\n      <p>{\"Клиент видит только заказы своей компании\"}</p>\n      <form onSubmit={(e) => { e.preventDefault(); void requests.create({ contact_name: form.name, contact_phone: form.phone }, { consent: true }); }}>\n        <Field name=\"contact_name\" label=\"Имя\" type=\"string\" value={form.name} onChange={(v) => setForm({ ...form, name: String(v) })} />\n        <Field name=\"contact_phone\" label=\"Телефон\" type=\"phone\" value={form.phone} onChange={(v) => setForm({ ...form, phone: String(v) })} />\n        <ConsentCheckbox checked={form.consent} onChange={(v) => setForm({ ...form, consent: v })} />\n        <Button type=\"submit\">{\"Отправить заявку\"}</Button>\n      </form>\n    </AppShell>\n  );\n}\n"
  }
