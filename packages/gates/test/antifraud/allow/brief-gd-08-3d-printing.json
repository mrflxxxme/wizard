    "ui/Main.tsx": "import { AppShell, Button, ConsentCheckbox, Field } from \"@wizard/ui-kit\";\nimport { useEntityMutation, useState } from \"@wizard/sdk\";\n\nexport default function Main() {\n  const [form, setForm] = useState({ name: \"\", phone: \"\", consent: false });\n  const requests = useEntityMutation(\"request\");\n  return (\n    <AppShell title={\"3D-печать на заказ: загрузка модели, расчёт, очередь принтеров\"}>\n      <p>{\"Студия 3D-печати: шесть FDM-принтеров и два фотополимерных, печатаем прототипы, запчасти и сувениры для частных клиентов и инженеров небольших компаний. Сейчас клиенты присылают модели в мессенджер, а расчёт делаем вручную. Нужен сервис: клиент входит по почте, загружает файл модели (STL или 3MF до 100 МБ), выбирает технологию, материал (PLA, PETG, ABS, смола), цвет, заполнение и количество. Предварительная цена считается по объёму модели, который клиент указывает в форме, и цене материала; точную цену оператор подтверждает после проверки модели и может вернуть заказ с комментарием, если модель непечатаемая. Клиент оплачивает подтверждённый заказ через ЮKassa, после этого заказ попадает в очередь. Оператор распределяет задания по принтерам с учётом технологии и материала, видит загрузку каждого принтера по дням и отмечает этапы: печать, постобработка, контроль качества, готов. Если печать сорвалась, оператор перезапускает задание, расход материала учитывается. Учёт катушек и смолы: остатки и предупреждение при низком остатке. Клиент видит статус и ориентировочную дату готовности только своих заказов. Отчёт: загрузка принтеров, расход материалов, выручка.\"}</p>\n      <ul>\n        <li>{\"Загрузка файла модели\"}</li>\n        <li>{\"Предварительный расчёт цены\"}</li>\n        <li>{\"Подтверждение цены оператором\"}</li>\n        <li>{\"Возврат непечатаемой модели\"}</li>\n        <li>{\"Оплата через ЮKassa\"}</li>\n        <li>{\"Очередь и распределение по принтерам\"}</li>\n        <li>{\"Перезапуск сорвавшейся печати\"}</li>\n        <li>{\"Учёт остатков материалов\"}</li>\n      </ul>\n      <p>{\"Заказ попадает в очередь только после оплаты\"}</p>\n      <p>{\"Задание назначается на принтер подходящей технологии\"}</p>\n      <p>{\"Клиент видит только свои заказы\"}</p>\n      <p>{\"Низкий остаток материала даёт предупреждение\"}</p>\n      <form onSubmit={(e) => { e.preventDefault(); void requests.create({ contact_name: form.name, contact_phone: form.phone }, { consent: true }); }}>\n        <Field name=\"contact_name\" label=\"Имя\" type=\"string\" value={form.name} onChange={(v) => setForm({ ...form, name: String(v) })} />\n        <Field name=\"contact_phone\" label=\"Телефон\" type=\"phone\" value={form.phone} onChange={(v) => setForm({ ...form, phone: String(v) })} />\n        <ConsentCheckbox checked={form.consent} onChange={(v) => setForm({ ...form, consent: v })} />\n        <Button type=\"submit\">{\"Отправить заявку\"}</Button>\n      </form>\n    </AppShell>\n  );\n}\n"
  }
