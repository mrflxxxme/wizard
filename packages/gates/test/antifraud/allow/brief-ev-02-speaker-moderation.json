  "files": {
    "ui/Main.tsx": "import { AppShell, Button, ConsentCheckbox, Field } from \"@wizard/ui-kit\";\nimport { useEntityMutation, useState } from \"@wizard/sdk\";\n\nexport default function Main() {\n  const [form, setForm] = useState({ name: \"\", phone: \"\", consent: false });\n  const requests = useEntityMutation(\"request\");\n  return (\n    <AppShell title={\"Приём и модерация заявок спикеров\"}>\n      <p>{\"Собираем программу конференции по цифровизации логистики: пять секций, в каждой 6–8 докладов. Хотим открыть приём заявок от спикеров: тема, аннотация, секция, формат (доклад 20 минут, мастер-класс 60 минут, панельная дискуссия), опыт выступлений, ссылка на презентацию. Заявки оценивает программный комитет: у каждой секции свой куратор и 2–3 эксперта, каждый ставит оценку от 1 до 5 и комментарий, эксперты не видят оценок друг друга. Куратор секции видит средний балл и принимает решение: принять, отклонить, попросить доработать. Спикеру уходит письмо о решении. Принятые доклады куратор ставит в сетку программы (зал, время), пересечения по залу и времени не допускаются. Итоговая программа публикуется на сайте.\"}</p>\n      <ul>\n        <li>{\"Формат доклада\"}</li>\n        <li>{\"Оценка 1–5 с комментарием\"}</li>\n        <li>{\"Слепая оценка экспертами\"}</li>\n        <li>{\"Средний балл\"}</li>\n        <li>{\"Решение принять/отклонить/доработать\"}</li>\n        <li>{\"Письмо спикеру о решении\"}</li>\n        <li>{\"Проверка пересечений зала и времени\"}</li>\n        <li>{\"Публикация программы\"}</li>\n      </ul>\n      <p>{\"Эксперт не видит чужие оценки\"}</p>\n      <p>{\"Спикер получает письмо о решении\"}</p>\n      <p>{\"Нельзя поставить два доклада в один зал на одно время\"}</p>\n      <p>{\"Куратор видит средний балл\"}</p>\n      <form onSubmit={(e) => { e.preventDefault(); void requests.create({ contact_name: form.name, contact_phone: form.phone }, { consent: true }); }}>\n        <Field name=\"contact_name\" label=\"Имя\" type=\"string\" value={form.name} onChange={(v) => setForm({ ...form, name: String(v) })} />\n        <Field name=\"contact_phone\" label=\"Телефон\" type=\"phone\" value={form.phone} onChange={(v) => setForm({ ...form, phone: String(v) })} />\n        <ConsentCheckbox checked={form.consent} onChange={(v) => setForm({ ...form, consent: v })} />\n        <Button type=\"submit\">{\"Отправить заявку\"}</Button>\n      </form>\n    </AppShell>\n  );\n}\n"
  }
