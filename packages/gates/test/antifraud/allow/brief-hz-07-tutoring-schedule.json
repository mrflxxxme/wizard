    "ui/Main.tsx": "import { AppShell, Button, ConsentCheckbox, Field } from \"@wizard/ui-kit\";\nimport { useEntityMutation, useState } from \"@wizard/sdk\";\n\nexport default function Main() {\n  const [form, setForm] = useState({ name: \"\", phone: \"\", consent: false });\n  const requests = useEntityMutation(\"request\");\n  return (\n    <AppShell title={\"Учебный центр: группы, расписание, посещаемость и абонементы\"}>\n      <p>{\"Учебный центр для школьников: английский, математика и шахматы, десять преподавателей, четыре кабинета. Расписание сейчас в таблице, родители путаются, кабинеты иногда заняты дважды. Нужна система: курсы, группы (до 8 детей), преподаватель группы, расписание занятий на четверть с кабинетом и временем. Один кабинет и один преподаватель не могут быть заняты в одно и то же время — система должна это проверять. Преподаватель отмечает посещаемость и пишет короткий комментарий к занятию. Родитель регистрируется по почте или через Telegram, записывает ребёнка в группу, если есть места, и видит расписание и посещаемость только своих детей. Оплата — абонементы на 8 занятий через ЮKassa; посещённое занятие списывается с абонемента, а когда осталось 2 занятия, родителю приходит напоминание. Если занятие отменили, всем родителям группы уходит уведомление. Администратор ведёт курсы, группы и расписание, переводит ребёнка между группами. Отчёт: заполненность групп, пропуски, продажи абонементов за месяц.\"}</p>\n      <ul>\n        <li>{\"Лимит 8 детей в группе\"}</li>\n        <li>{\"Проверка занятости кабинета и преподавателя\"}</li>\n        <li>{\"Посещаемость\"}</li>\n        <li>{\"Оплата абонемента через ЮKassa\"}</li>\n        <li>{\"Списание занятия с абонемента\"}</li>\n        <li>{\"Напоминание об окончании абонемента\"}</li>\n        <li>{\"Уведомление об отмене занятия\"}</li>\n        <li>{\"Вход через Telegram\"}</li>\n        <li>{\"Отчёт по заполненности и пропускам\"}</li>\n      </ul>\n      <p>{\"Нельзя поставить два занятия в один кабинет в одно время\"}</p>\n      <p>{\"Родитель видит только своих детей\"}</p>\n      <p>{\"Нельзя записать в полную группу\"}</p>\n      <p>{\"Посещённое занятие списывается с абонемента\"}</p>\n      <form onSubmit={(e) => { e.preventDefault(); void requests.create({ contact_name: form.name, contact_phone: form.phone }, { consent: true }); }}>\n        <Field name=\"contact_name\" label=\"Имя\" type=\"string\" value={form.name} onChange={(v) => setForm({ ...form, name: String(v) })} />\n        <Field name=\"contact_phone\" label=\"Телефон\" type=\"phone\" value={form.phone} onChange={(v) => setForm({ ...form, phone: String(v) })} />\n        <ConsentCheckbox checked={form.consent} onChange={(v) => setForm({ ...form, consent: v })} />\n        <Button type=\"submit\">{\"Отправить заявку\"}</Button>\n      </form>\n    </AppShell>\n  );\n}\n"
  }
