    "ui/Main.tsx": "import { AppShell, Button, ConsentCheckbox, Field } from \"@wizard/ui-kit\";\nimport { useEntityMutation, useState } from \"@wizard/sdk\";\n\nexport default function Main() {\n  const [form, setForm] = useState({ name: \"\", phone: \"\", consent: false });\n  const requests = useEntityMutation(\"request\");\n  return (\n    <AppShell title={\"B2B-портал с прайсом по контрагенту для небольшого производителя\"}>\n      <p>{\"Мы небольшой производитель бытовой химии, работаем с 150 оптовыми покупателями — магазинами и дистрибьюторами. Сейчас прайсы рассылаем в Excel и заказы принимаем по почте. Хотим личный кабинет для покупателей: каждый видит каталог со своими ценами (у контрагента есть ценовая группа: розница-опт, опт, дистрибьютор, плюс индивидуальные скидки на отдельные товары), остатки на складе и минимальную партию (кратность упаковки). Покупатель собирает заказ, видит сумму и отправляет; менеджер подтверждает или корректирует количество, после этого формируется счёт. Оплата — по безналу, менеджер отмечает поступление, либо отсрочка платежа для отдельных контрагентов с кредитным лимитом. Статусы: новый, подтверждён, собран, отгружен. Покупатель может повторить прошлый заказ. Каталог и остатки загружаем из Excel раз в день. У одного контрагента может быть несколько сотрудников-пользователей.\"}</p>\n      <ul>\n        <li>{\"Цены по ценовой группе\"}</li>\n        <li>{\"Индивидуальные скидки\"}</li>\n        <li>{\"Остатки\"}</li>\n        <li>{\"Кратность/минимальная партия\"}</li>\n        <li>{\"Корректировка менеджером\"}</li>\n        <li>{\"Отсрочка и кредитный лимит\"}</li>\n        <li>{\"Повтор заказа\"}</li>\n        <li>{\"Импорт из Excel\"}</li>\n        <li>{\"Несколько пользователей у контрагента\"}</li>\n      </ul>\n      <p>{\"Покупатель видит только цены своей ценовой группы\"}</p>\n      <p>{\"Нельзя заказать количество не кратное упаковке\"}</p>\n      <p>{\"Заказ сверх кредитного лимита не подтверждается\"}</p>\n      <p>{\"Покупатель видит заказы только своего контрагента\"}</p>\n      <form onSubmit={(e) => { e.preventDefault(); void requests.create({ contact_name: form.name, contact_phone: form.phone }, { consent: true }); }}>\n        <Field name=\"contact_name\" label=\"Имя\" type=\"string\" value={form.name} onChange={(v) => setForm({ ...form, name: String(v) })} />\n        <Field name=\"contact_phone\" label=\"Телефон\" type=\"phone\" value={form.phone} onChange={(v) => setForm({ ...form, phone: String(v) })} />\n        <ConsentCheckbox checked={form.consent} onChange={(v) => setForm({ ...form, consent: v })} />\n        <Button type=\"submit\">{\"Отправить заявку\"}</Button>\n      </form>\n    </AppShell>\n  );\n}\n"
  }
