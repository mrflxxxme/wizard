    "ui/Main.tsx": "import { AppShell, Button, ConsentCheckbox, Field } from \"@wizard/ui-kit\";\nimport { useEntityMutation, useState } from \"@wizard/sdk\";\n\nexport default function Main() {\n  const [form, setForm] = useState({ name: \"\", phone: \"\", consent: false });\n  const requests = useEntityMutation(\"request\");\n  return (\n    <AppShell title={\"Регистрация на отраслевой форум с типами билетов\"}>\n      <p>{\"Мы проводим двухдневный отраслевой форум для производителей упаковки, ждём около 1200 человек. Нужна регистрация с типами билетов: стандарт, бизнес (с доступом в лаунж и на закрытый ужин), онлайн-трансляция и студенческий (бесплатный, но с проверкой студенческого билета модератором). У каждого типа свой лимит мест и своя цена, цены растут по датам (ранняя, основная, поздняя). Промокоды на скидку в процентах, с лимитом использований. Оплата картой онлайн, юрлица могут получить счёт и оплатить по нему — тогда билет выдаётся после того, как бухгалтер отметит оплату. После оплаты участник получает на почту QR-билет. В анкете — компания, должность, отрасль и согласие на обработку данных. Организатору нужен отчёт: продажи по типам билетов и по дням, заполненность лимитов, выгрузка участников в Excel.\"}</p>\n      <ul>\n        <li>{\"Лимит мест по типу билета\"}</li>\n        <li>{\"Цены по периодам\"}</li>\n        <li>{\"Промокоды с лимитом\"}</li>\n        <li>{\"Онлайн-оплата\"}</li>\n        <li>{\"Оплата по счёту для юрлиц\"}</li>\n        <li>{\"QR-билет на почту\"}</li>\n        <li>{\"Проверка студенческого\"}</li>\n        <li>{\"Согласие на обработку ПДн\"}</li>\n        <li>{\"Выгрузка в Excel\"}</li>\n      </ul>\n      <p>{\"Нельзя продать билет сверх лимита\"}</p>\n      <p>{\"Студенческий билет выдаётся после одобрения\"}</p>\n      <p>{\"Билет по счёту выдаётся после отметки оплаты\"}</p>\n      <p>{\"Промокод перестаёт работать после лимита\"}</p>\n      <p>{\"QR-билет приходит после оплаты\"}</p>\n      <form onSubmit={(e) => { e.preventDefault(); void requests.create({ contact_name: form.name, contact_phone: form.phone }, { consent: true }); }}>\n        <Field name=\"contact_name\" label=\"Имя\" type=\"string\" value={form.name} onChange={(v) => setForm({ ...form, name: String(v) })} />\n        <Field name=\"contact_phone\" label=\"Телефон\" type=\"phone\" value={form.phone} onChange={(v) => setForm({ ...form, phone: String(v) })} />\n        <ConsentCheckbox checked={form.consent} onChange={(v) => setForm({ ...form, consent: v })} />\n        <Button type=\"submit\">{\"Отправить заявку\"}</Button>\n      </form>\n    </AppShell>\n  );\n}\n"
  }
