  "files": {
    "ui/Main.tsx": "import { AppShell, Button, ConsentCheckbox, Field } from \"@wizard/ui-kit\";\nimport { useEntityMutation, useState } from \"@wizard/sdk\";\n\nexport default function Main() {\n  const [form, setForm] = useState({ name: \"\", phone: \"\", consent: false });\n  const requests = useEntityMutation(\"request\");\n  return (\n    <AppShell title={\"Хакатон: команды, кейсы, жюри\"}>\n      <p>{\"Проводим корпоративный хакатон на 48 часов для студентов и молодых разработчиков. Участники регистрируются по одному или сразу командой; одиночки могут найти команду через доску «ищу команду» с навыками. В команде от 2 до 5 человек, у команды есть капитан. Компании-партнёры дают кейсы, команда выбирает один кейс до старта. Во время хакатона менторы отмечают, какие команды проконсультировали. Команда сдаёт решение: ссылка на репозиторий, презентация, видео до дедлайна, после дедлайна сдача закрывается. Жюри оценивает по критериям (идея, техническая реализация, презентация) с весами, итог считается автоматически, лидерборд по каждому кейсу. Победители получают призы, всем участникам — электронный сертификат.\"}</p>\n      <ul>\n        <li>{\"Размер команды 2–5\"}</li>\n        <li>{\"Поиск команды одиночками\"}</li>\n        <li>{\"Выбор кейса\"}</li>\n        <li>{\"Отметки менторов\"}</li>\n        <li>{\"Дедлайн сдачи\"}</li>\n        <li>{\"Веса критериев\"}</li>\n        <li>{\"Лидерборд\"}</li>\n        <li>{\"Сертификаты участникам\"}</li>\n      </ul>\n      <p>{\"Нельзя создать команду больше 5 человек\"}</p>\n      <p>{\"После дедлайна сдача закрыта\"}</p>\n      <p>{\"Итоговый балл считается по весам\"}</p>\n      <p>{\"Лидерборд по каждому кейсу\"}</p>\n      <form onSubmit={(e) => { e.preventDefault(); void requests.create({ contact_name: form.name, contact_phone: form.phone }, { consent: true }); }}>\n        <Field name=\"contact_name\" label=\"Имя\" type=\"string\" value={form.name} onChange={(v) => setForm({ ...form, name: String(v) })} />\n        <Field name=\"contact_phone\" label=\"Телефон\" type=\"phone\" value={form.phone} onChange={(v) => setForm({ ...form, phone: String(v) })} />\n        <ConsentCheckbox checked={form.consent} onChange={(v) => setForm({ ...form, consent: v })} />\n        <Button type=\"submit\">{\"Отправить заявку\"}</Button>\n      </form>\n    </AppShell>\n  );\n}\n"
  }
