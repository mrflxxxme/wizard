    "ui/Main.tsx": "import { AppShell, Button, ConsentCheckbox, Field } from \"@wizard/ui-kit\";\nimport { useEntityMutation, useState } from \"@wizard/sdk\";\n\nexport default function Main() {\n  const [form, setForm] = useState({ name: \"\", phone: \"\", consent: false });\n  const requests = useEntityMutation(\"request\");\n  return (\n    <AppShell title={\"Конфигуратор торта и предзаказ\"}>\n      <p>{\"Небольшая кондитерская, делаем торты на заказ. Хотим, чтобы клиент сам собирал торт на сайте: число ярусов (1–3), вес (от 1,5 кг, шаг 0,5 кг), начинка из списка (у некоторых начинок наценка), покрытие, декор (ягоды, фигурки, надпись, фото-печать — каждое с ценой). Цена считается сразу. Дату выдачи можно выбрать не раньше чем через 3 дня, и в день мы берём не больше 8 тортов — занятые дни закрыты. Для оформления нужна предоплата 50% онлайн, остаток при получении. Клиент может приложить картинку-референс. Кондитер видит заказы на неделю по дням с составом, отмечает статусы: принят, в работе, готов, выдан. Клиенту уходят уведомления о смене статуса. Доставка — по зонам города с разной ценой, или самовывоз. Администратор меняет прайс начинок и декора без программиста.\"}</p>\n      <ul>\n        <li>{\"Калькулятор цены\"}</li>\n        <li>{\"Ярусы и вес\"}</li>\n        <li>{\"Наценка за начинку\"}</li>\n        <li>{\"Дата не раньше чем через 3 дня\"}</li>\n        <li>{\"Лимит 8 тортов в день\"}</li>\n        <li>{\"Предоплата 50%\"}</li>\n        <li>{\"Онлайн-оплата\"}</li>\n        <li>{\"Загрузка референса\"}</li>\n        <li>{\"Статусы производства\"}</li>\n        <li>{\"Доставка по зонам или самовывоз\"}</li>\n      </ul>\n      <p>{\"Цена пересчитывается при изменении параметров\"}</p>\n      <p>{\"Нельзя выбрать дату раньше чем через 3 дня\"}</p>\n      <p>{\"Занятые дни недоступны\"}</p>\n      <p>{\"Заказ подтверждается после предоплаты\"}</p>\n      <p>{\"Клиент получает уведомление о смене статуса\"}</p>\n      <form onSubmit={(e) => { e.preventDefault(); void requests.create({ contact_name: form.name, contact_phone: form.phone }, { consent: true }); }}>\n        <Field name=\"contact_name\" label=\"Имя\" type=\"string\" value={form.name} onChange={(v) => setForm({ ...form, name: String(v) })} />\n        <Field name=\"contact_phone\" label=\"Телефон\" type=\"phone\" value={form.phone} onChange={(v) => setForm({ ...form, phone: String(v) })} />\n        <ConsentCheckbox checked={form.consent} onChange={(v) => setForm({ ...form, consent: v })} />\n        <Button type=\"submit\">{\"Отправить заявку\"}</Button>\n      </form>\n    </AppShell>\n  );\n}\n"
  }
