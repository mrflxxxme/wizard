  "files": {
    "ui/Main.tsx": "import { AppShell, Button, ConsentCheckbox, Field } from \"@wizard/ui-kit\";\nimport { useEntityMutation, useState } from \"@wizard/sdk\";\n\nexport default function Main() {\n  const [form, setForm] = useState({ name: \"\", phone: \"\", consent: false });\n  const requests = useEntityMutation(\"request\");\n  return (\n    <AppShell title={\"Волонтёры, смены и чек-ин по QR\"}>\n      <p>{\"Городской фестиваль на 5000 гостей, работают 80 волонтёров. Нужно: волонтёры подают анкету (размер футболки, опыт, в какие дни свободны), координатор одобряет и распределяет их по сменам и зонам (вход, навигация, инфостойка, backstage). У каждой смены есть нужное число людей, координатор видит, где не хватает. Волонтёр видит своё расписание и может отказаться от смены не позже чем за сутки. На входе волонтёры сканируют QR-билеты гостей с телефона; интернет на площадке плохой, поэтому сканер должен работать офлайн и синхронизироваться потом, повторный проход по одному билету должен ловиться. В зону backstage пускаем только билеты с доступом в эту зону. Старший смены видит статистику входа в реальном времени.\"}</p>\n      <ul>\n        <li>{\"Одобрение анкеты\"}</li>\n        <li>{\"Потребность смены и нехватка\"}</li>\n        <li>{\"Отказ от смены не позже чем за сутки\"}</li>\n        <li>{\"Сканер QR\"}</li>\n        <li>{\"Офлайн-режим и синхронизация\"}</li>\n        <li>{\"Защита от повторного прохода\"}</li>\n        <li>{\"Доступ по зонам\"}</li>\n        <li>{\"Статистика входа в реальном времени\"}</li>\n      </ul>\n      <p>{\"Повторный проход по билету отклоняется\"}</p>\n      <p>{\"Сканер работает без сети и синхронизирует данные\"}</p>\n      <p>{\"Билет без доступа не проходит в backstage\"}</p>\n      <p>{\"Отказ от смены позже чем за сутки невозможен\"}</p>\n      <form onSubmit={(e) => { e.preventDefault(); void requests.create({ contact_name: form.name, contact_phone: form.phone }, { consent: true }); }}>\n        <Field name=\"contact_name\" label=\"Имя\" type=\"string\" value={form.name} onChange={(v) => setForm({ ...form, name: String(v) })} />\n        <Field name=\"contact_phone\" label=\"Телефон\" type=\"phone\" value={form.phone} onChange={(v) => setForm({ ...form, phone: String(v) })} />\n        <ConsentCheckbox checked={form.consent} onChange={(v) => setForm({ ...form, consent: v })} />\n        <Button type=\"submit\">{\"Отправить заявку\"}</Button>\n      </form>\n    </AppShell>\n  );\n}\n"
  }
