  "files": {
    "ui/Main.tsx": "import { AppShell, Button, ConsentCheckbox, Field } from \"@wizard/ui-kit\";\nimport { useEntityMutation, useState } from \"@wizard/sdk\";\n\nexport default function Main() {\n  const [form, setForm] = useState({ name: \"\", phone: \"\", consent: false });\n  const requests = useEntityMutation(\"request\");\n  return (\n    <AppShell title={\"Кабинет партнёров с квотами на билеты\"}>\n      <p>{\"У нашей выставки 40 партнёров и спонсоров с разными пакетами: генеральный, золотой, серебряный, экспонент. В пакет входит квота бесплатных билетов (например, у генерального 30 полных и 50 гостевых, у экспонента 5 полных и 10 гостевых), стенд определённой площади и логотип в каталоге. Нужен кабинет партнёра: менеджер партнёра сам регистрирует своих сотрудников и гостей в пределах квоты, видит остаток, может заменить человека до определённой даты, загружает логотип и описание для каталога. Если квоты не хватает, партнёр может докупить билеты по партнёрской цене. Наш менеджер по партнёрам заводит партнёров, назначает пакеты, может вручную увеличить квоту и проверяет материалы для каталога перед публикацией. Нужен отчёт: использование квот по партнёрам. Сейчас квоты вручную ведёт наш координатор клиент, вопросы партнёров он собирает в Telegram клиент.\"}</p>\n      <ul>\n        <li>{\"Квота полных и гостевых билетов\"}</li>\n        <li>{\"Остаток квоты\"}</li>\n        <li>{\"Замена участника до даты\"}</li>\n        <li>{\"Докупка билетов\"}</li>\n        <li>{\"Ручное увеличение квоты\"}</li>\n        <li>{\"Модерация материалов каталога\"}</li>\n        <li>{\"Загрузка логотипа\"}</li>\n        <li>{\"Отчёт по использованию квот\"}</li>\n      </ul>\n      <p>{\"Партнёр не может зарегистрировать больше квоты\"}</p>\n      <p>{\"Партнёр видит только своих гостей\"}</p>\n      <p>{\"Замена невозможна после дедлайна\"}</p>\n      <p>{\"Материалы не публикуются без проверки\"}</p>\n      <form onSubmit={(e) => { e.preventDefault(); void requests.create({ contact_name: form.name, contact_phone: form.phone }, { consent: true }); }}>\n        <Field name=\"contact_name\" label=\"Имя\" type=\"string\" value={form.name} onChange={(v) => setForm({ ...form, name: String(v) })} />\n        <Field name=\"contact_phone\" label=\"Телефон\" type=\"phone\" value={form.phone} onChange={(v) => setForm({ ...form, phone: String(v) })} />\n        <ConsentCheckbox checked={form.consent} onChange={(v) => setForm({ ...form, consent: v })} />\n        <Button type=\"submit\">{\"Отправить заявку\"}</Button>\n      </form>\n    </AppShell>\n  );\n}\n"
  }
