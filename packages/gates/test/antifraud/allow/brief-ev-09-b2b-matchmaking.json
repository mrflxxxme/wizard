  "files": {
    "ui/Main.tsx": "import { AppShell, Button, ConsentCheckbox, Field } from \"@wizard/ui-kit\";\nimport { useEntityMutation, useState } from \"@wizard/sdk\";\n\nexport default function Main() {\n  const [form, setForm] = useState({ name: \"\", phone: \"\", consent: false });\n  const requests = useEntityMutation(\"request\");\n  return (\n    <AppShell title={\"Деловые встречи 1:1 на конференции\"}>\n      <p>{\"На нашей конференции для ритейла (около 600 участников) главная ценность — встречи поставщиков с закупщиками сетей. Сейчас встречи назначаем вручную в таблице. Нужен сервис матчмейкинга: участник после регистрации заполняет профиль компании (роль — поставщик или закупщик, категории товаров, что ищет), профили видны другим участникам конференции. В день конференции работают два зала со столами, слоты по 30 минут с 11:00 до 17:00. Поставщик отправляет закупщику запрос на встречу в свободный слот с сообщением, закупщик принимает или отклоняет. Принятая встреча получает номер стола; у участника не может быть двух встреч в одном слоте, у стола — тоже. Закупщик может закрыть свой календарь от новых запросов и ограничить число встреч. За 15 минут до встречи обоим приходит напоминание в Telegram. Организатор видит сетку столов, может переназначить стол и добавить VIP-встречи вручную. После встречи обе стороны отмечают, состоялась ли она и интересно ли продолжение. Отчёт: сколько встреч назначено и состоялось, самые востребованные закупщики.\"}</p>\n      <ul>\n        <li>{\"Слоты по 30 минут\"}</li>\n        <li>{\"Принятие или отклонение запроса\"}</li>\n        <li>{\"Назначение стола\"}</li>\n        <li>{\"Запрет двух встреч в одном слоте\"}</li>\n        <li>{\"Лимит встреч закупщика\"}</li>\n        <li>{\"Напоминание в Telegram\"}</li>\n        <li>{\"Отметка состоявшейся встречи\"}</li>\n        <li>{\"Отчёт по встречам\"}</li>\n      </ul>\n      <p>{\"У участника нет двух встреч в одном слоте\"}</p>\n      <p>{\"За одним столом в слоте — одна встреча\"}</p>\n      <p>{\"Закупщик с закрытым календарём не получает запросов\"}</p>\n      <p>{\"Встреча получает стол только после принятия\"}</p>\n      <form onSubmit={(e) => { e.preventDefault(); void requests.create({ contact_name: form.name, contact_phone: form.phone }, { consent: true }); }}>\n        <Field name=\"contact_name\" label=\"Имя\" type=\"string\" value={form.name} onChange={(v) => setForm({ ...form, name: String(v) })} />\n        <Field name=\"contact_phone\" label=\"Телефон\" type=\"phone\" value={form.phone} onChange={(v) => setForm({ ...form, phone: String(v) })} />\n        <ConsentCheckbox checked={form.consent} onChange={(v) => setForm({ ...form, consent: v })} />\n        <Button type=\"submit\">{\"Отправить заявку\"}</Button>\n      </form>\n    </AppShell>\n  );\n}\n"
  }
