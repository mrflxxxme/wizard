    "ui/Main.tsx": "import { AppShell, Button, ConsentCheckbox, Field } from \"@wizard/ui-kit\";\nimport { useEntityMutation, useState } from \"@wizard/sdk\";\n\nexport default function Main() {\n  const [form, setForm] = useState({ name: \"\", phone: \"\", consent: false });\n  const requests = useEntityMutation(\"request\");\n  return (\n    <AppShell title={\"Прокат строительного инструмента с бронированием и залогом\"}>\n      <p>{\"Прокат строительного инструмента: перфораторы, бетономешалки, леса, около 300 единиц. Клиенты — частники и небольшие бригады. Нужен сайт с каталогом: модель, фото, цена за сутки и за неделю, сумма залога, наличие. Клиент входит по почте или через Telegram, выбирает даты и бронирует конкретную единицу; одна единица не может быть забронирована на пересекающиеся даты. Залог и аренда оплачиваются онлайн через ЮKassa при бронировании, без оплаты бронь снимается через 2 часа. Документы клиента не сканируем и не храним, нас страхует залог. При выдаче менеджер отмечает комплектность и состояние, при возврате — состояние и повреждения с фото. Если инструмент вернули позже, система считает доплату за каждые сутки просрочки; за повреждение удерживается часть залога по решению менеджера, остаток залога возвращается. Механик ставит единицу на обслуживание — на эти даты бронь недоступна. Клиент видит свои брони и историю. Владелец видит загрузку по каждой единице, выручку за месяц и единицы, которые давно не сдавались.\"}</p>\n      <ul>\n        <li>{\"Цена за сутки и неделю\"}</li>\n        <li>{\"Бронирование на даты без пересечений\"}</li>\n        <li>{\"Оплата и залог через ЮKassa\"}</li>\n        <li>{\"Автоснятие неоплаченной брони\"}</li>\n        <li>{\"Выдача и возврат с отметкой состояния\"}</li>\n        <li>{\"Доплата за просрочку\"}</li>\n        <li>{\"Удержание из залога\"}</li>\n        <li>{\"Блокировка на обслуживание\"}</li>\n      </ul>\n      <p>{\"Единица не бронируется на пересекающиеся даты\"}</p>\n      <p>{\"Неоплаченная бронь снимается через 2 часа\"}</p>\n      <p>{\"Клиент видит только свои брони\"}</p>\n      <p>{\"На время обслуживания бронь недоступна\"}</p>\n      <form onSubmit={(e) => { e.preventDefault(); void requests.create({ contact_name: form.name, contact_phone: form.phone }, { consent: true }); }}>\n        <Field name=\"contact_name\" label=\"Имя\" type=\"string\" value={form.name} onChange={(v) => setForm({ ...form, name: String(v) })} />\n        <Field name=\"contact_phone\" label=\"Телефон\" type=\"phone\" value={form.phone} onChange={(v) => setForm({ ...form, phone: String(v) })} />\n        <ConsentCheckbox checked={form.consent} onChange={(v) => setForm({ ...form, consent: v })} />\n        <Button type=\"submit\">{\"Отправить заявку\"}</Button>\n      </form>\n    </AppShell>\n  );\n}\n"
  }
