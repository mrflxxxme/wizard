    "ui/Main.tsx": "import { AppShell, Button, ConsentCheckbox, Field } from \"@wizard/ui-kit\";\nimport { useEntityMutation, useState } from \"@wizard/sdk\";\n\nexport default function Main() {\n  const [form, setForm] = useState({ name: \"\", phone: \"\", consent: false });\n  const requests = useEntityMutation(\"request\");\n  return (\n    <AppShell title={\"Обеды для офисов: меню недели, заказ до дедлайна, доставка\"}>\n      <p>{\"Небольшая кухня готовит обеды для офисов: 15 компаний-клиентов, около 300 порций в день. Меню на следующую неделю публикуем в пятницу: пять дней, в каждом три варианта горячего, салат и суп, у блюд указаны состав, вес, калорийность и маркировка аллергенов. Сотрудник компании-клиента входит по рабочей почте и до четверга 16:00 выбирает обеды на неделю, менять выбор можно до 10:00 предыдущего дня. Компания платит за обеды своих сотрудников раз в месяц по счёту, у компании есть лимит на сотрудника в день, сверх лимита сотрудник доплачивает сам онлайн через ЮKassa. Ответственный от компании видит, кто что заказал, и добавляет или отключает сотрудников. Кухня получает на каждый день сводку: сколько порций каждого блюда, а также закупочный лист ингредиентов по технологическим картам. Курьер видит, сколько коробок везти в какую компанию, и отмечает доставку. Отчёт за месяц для каждой компании: порции и суммы по сотрудникам, для кухни — популярность блюд.\"}</p>\n      <ul>\n        <li>{\"Дедлайн заказа в четверг\"}</li>\n        <li>{\"Изменение выбора до 10:00\"}</li>\n        <li>{\"Лимит компании на сотрудника\"}</li>\n        <li>{\"Доплата сверх лимита через ЮKassa\"}</li>\n        <li>{\"Сводка порций на день\"}</li>\n        <li>{\"Закупочный лист по техкартам\"}</li>\n        <li>{\"Маркировка аллергенов\"}</li>\n        <li>{\"Счёт компании за месяц\"}</li>\n      </ul>\n      <p>{\"После дедлайна заказ на неделю не принимается\"}</p>\n      <p>{\"Сверх лимита сотрудник доплачивает сам\"}</p>\n      <p>{\"Ответственный видит только сотрудников своей компании\"}</p>\n      <p>{\"Сводка кухни считается по всем заказам дня\"}</p>\n      <form onSubmit={(e) => { e.preventDefault(); void requests.create({ contact_name: form.name, contact_phone: form.phone }, { consent: true }); }}>\n        <Field name=\"contact_name\" label=\"Имя\" type=\"string\" value={form.name} onChange={(v) => setForm({ ...form, name: String(v) })} />\n        <Field name=\"contact_phone\" label=\"Телефон\" type=\"phone\" value={form.phone} onChange={(v) => setForm({ ...form, phone: String(v) })} />\n        <ConsentCheckbox checked={form.consent} onChange={(v) => setForm({ ...form, consent: v })} />\n        <Button type=\"submit\">{\"Отправить заявку\"}</Button>\n      </form>\n    </AppShell>\n  );\n}\n"
  }
