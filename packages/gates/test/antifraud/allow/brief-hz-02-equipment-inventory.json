  "files": {
    "ui/Main.tsx": "import { AppShell, Button, ConsentCheckbox, Field } from \"@wizard/ui-kit\";\nimport { useEntityMutation, useState } from \"@wizard/sdk\";\n\nexport default function Main() {\n  const [form, setForm] = useState({ name: \"\", phone: \"\", consent: false });\n  const requests = useEntityMutation(\"request\");\n  return (\n    <AppShell title={\"Учёт оборудования и выдачи сотрудникам\"}>\n      <p>{\"У нас прокатное и рабочее оборудование для выездных мероприятий: проекторы, микрофоны, ноутбуки, стойки, кабели — около 400 единиц. Нужен внутренний учёт: у каждой единицы инвентарный номер, категория, серийный номер, состояние, место хранения, фото. На каждую единицу печатаем QR-наклейку. Сотрудник бронирует оборудование на даты выезда — нельзя забронировать то, что уже занято. Кладовщик выдаёт и принимает по сканированию QR, при возврате отмечает состояние и неисправности; неисправное уходит в ремонт и недоступно для брони. Комплекты (например, «звук на 100 человек») бронируются целиком. Руководитель видит загрузку оборудования по месяцам и историю по каждой единице. Раз в год — инвентаризация по сканированию.\"}</p>\n      <ul>\n        <li>{\"Инвентарный и серийный номер\"}</li>\n        <li>{\"QR-наклейки\"}</li>\n        <li>{\"Проверка пересечения броней\"}</li>\n        <li>{\"Выдача и приём по сканированию\"}</li>\n        <li>{\"Состояние при возврате\"}</li>\n        <li>{\"Ремонт блокирует бронь\"}</li>\n        <li>{\"Бронь комплекта целиком\"}</li>\n        <li>{\"Загрузка и история\"}</li>\n        <li>{\"Инвентаризация\"}</li>\n      </ul>\n      <p>{\"Нельзя забронировать занятое оборудование\"}</p>\n      <p>{\"Неисправное оборудование недоступно для брони\"}</p>\n      <p>{\"Выдача фиксируется сканированием QR\"}</p>\n      <p>{\"По каждой единице видна история выдач\"}</p>\n      <form onSubmit={(e) => { e.preventDefault(); void requests.create({ contact_name: form.name, contact_phone: form.phone }, { consent: true }); }}>\n        <Field name=\"contact_name\" label=\"Имя\" type=\"string\" value={form.name} onChange={(v) => setForm({ ...form, name: String(v) })} />\n        <Field name=\"contact_phone\" label=\"Телефон\" type=\"phone\" value={form.phone} onChange={(v) => setForm({ ...form, phone: String(v) })} />\n        <ConsentCheckbox checked={form.consent} onChange={(v) => setForm({ ...form, consent: v })} />\n        <Button type=\"submit\">{\"Отправить заявку\"}</Button>\n      </form>\n    </AppShell>\n  );\n}\n"
  }
