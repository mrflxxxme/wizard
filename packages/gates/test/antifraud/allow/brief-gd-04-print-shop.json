  "files": {
    "ui/Main.tsx": "import { AppShell, Button, ConsentCheckbox, Field } from \"@wizard/ui-kit\";\nimport { useEntityMutation, useState } from \"@wizard/sdk\";\n\nexport default function Main() {\n  const [form, setForm] = useState({ name: \"\", phone: \"\", consent: false });\n  const requests = useEntityMutation(\"request\");\n  return (\n    <AppShell title={\"Типография: заказ печати с загрузкой макета\"}>\n      <p>{\"Типография: визитки, листовки, буклеты, баннеры. Клиент на сайте выбирает продукт, формат, бумагу (плотность, тип), цветность, тираж, постобработку (ламинация, скругление углов, биговка) и срочность — цена считается по нашей таблице, для больших тиражей скидка по ступеням. Клиент загружает макет PDF. Специалист препресса проверяет макет (вылеты, разрешение, цветовой профиль) и либо принимает, либо возвращает с комментарием — клиент загружает исправленную версию. Печать начинается только после оплаты и принятого макета. Для постоянных клиентов-юрлиц — оплата по счёту и отсрочка. Статусы: ожидает макет, на проверке, в печати, готов к выдаче, выдан. Клиенту — уведомление, когда заказ готов, с адресом пункта выдачи. Оператор производства видит очередь печати по оборудованию.\"}</p>\n      <ul>\n        <li>{\"Параметры: формат, бумага, тираж\"}</li>\n        <li>{\"Постобработка\"}</li>\n        <li>{\"Срочность\"}</li>\n        <li>{\"Скидка по ступеням тиража\"}</li>\n        <li>{\"Загрузка PDF\"}</li>\n        <li>{\"Проверка макета с возвратом\"}</li>\n        <li>{\"Версии макета\"}</li>\n        <li>{\"Печать только после оплаты и принятого макета\"}</li>\n        <li>{\"Оплата по счёту\"}</li>\n        <li>{\"Очередь печати по оборудованию\"}</li>\n      </ul>\n      <p>{\"Цена считается по параметрам и тиражу\"}</p>\n      <p>{\"Заказ не уходит в печать без оплаты и принятого макета\"}</p>\n      <p>{\"Отклонённый макет возвращается клиенту с комментарием\"}</p>\n      <p>{\"Клиент получает уведомление о готовности\"}</p>\n      <form onSubmit={(e) => { e.preventDefault(); void requests.create({ contact_name: form.name, contact_phone: form.phone }, { consent: true }); }}>\n        <Field name=\"contact_name\" label=\"Имя\" type=\"string\" value={form.name} onChange={(v) => setForm({ ...form, name: String(v) })} />\n        <Field name=\"contact_phone\" label=\"Телефон\" type=\"phone\" value={form.phone} onChange={(v) => setForm({ ...form, phone: String(v) })} />\n        <ConsentCheckbox checked={form.consent} onChange={(v) => setForm({ ...form, consent: v })} />\n        <Button type=\"submit\">{\"Отправить заявку\"}</Button>\n      </form>\n    </AppShell>\n  );\n}\n"
  }
