  "files": {
    "ui/Main.tsx": "import { AppShell, Button, ConsentCheckbox, Field } from \"@wizard/ui-kit\";\nimport { useEntityMutation, useState } from \"@wizard/sdk\";\n\nexport default function Main() {\n  const [form, setForm] = useState({ name: \"\", phone: \"\", consent: false });\n  const requests = useEntityMutation(\"request\");\n  return (\n    <AppShell title={\"Коворкинг: бронь переговорных и рабочих мест\"}>\n      <p>{\"Коворкинг на 60 мест и три переговорные. Резиденты платят за месячный тариф, в который входит пакет часов переговорных, гости покупают разовый день. Нужна система бронирования: резидент входит по почте и бронирует переговорную по часам или рабочее место на день, видит занятость на неделю вперёд. Двойная бронь одного помещения на одно время невозможна. Часы переговорных списываются с пакета резидента; если пакет закончился, лишние часы оплачиваются через ЮKassa. Бронь можно отменить бесплатно не позже чем за 2 часа, иначе часы сгорают. Резидент может приглашать гостей: гость получает QR-код на почту, администратор на ресепшене сканирует его при входе. У компании-резидента может быть несколько сотрудников с общим пакетом часов, а её контактное лицо видит брони всех своих сотрудников. Администратор управляет тарифами и помещениями и видит загрузку. Отчёт за месяц: загрузка переговорных по часам, выручка от разовых посещений и от превышения пакетов.\"}</p>\n      <ul>\n        <li>{\"Бронь по часам\"}</li>\n        <li>{\"Запрет двойной брони\"}</li>\n        <li>{\"Списание часов с пакета\"}</li>\n        <li>{\"Оплата превышения через ЮKassa\"}</li>\n        <li>{\"Бесплатная отмена за 2 часа\"}</li>\n        <li>{\"QR-код гостя\"}</li>\n        <li>{\"Общий пакет компании\"}</li>\n        <li>{\"Отчёт по загрузке\"}</li>\n      </ul>\n      <p>{\"Нельзя забронировать занятое помещение\"}</p>\n      <p>{\"Поздняя отмена не возвращает часы\"}</p>\n      <p>{\"Контактное лицо видит брони сотрудников своей компании\"}</p>\n      <p>{\"Гость проходит по QR-коду\"}</p>\n      <form onSubmit={(e) => { e.preventDefault(); void requests.create({ contact_name: form.name, contact_phone: form.phone }, { consent: true }); }}>\n        <Field name=\"contact_name\" label=\"Имя\" type=\"string\" value={form.name} onChange={(v) => setForm({ ...form, name: String(v) })} />\n        <Field name=\"contact_phone\" label=\"Телефон\" type=\"phone\" value={form.phone} onChange={(v) => setForm({ ...form, phone: String(v) })} />\n        <ConsentCheckbox checked={form.consent} onChange={(v) => setForm({ ...form, consent: v })} />\n        <Button type=\"submit\">{\"Отправить заявку\"}</Button>\n      </form>\n    </AppShell>\n  );\n}\n"
  }
