  "files": {
    "ui/Main.tsx": "import { AppShell, Button, ConsentCheckbox, Field } from \"@wizard/ui-kit\";\nimport { useEntityMutation, useState } from \"@wizard/sdk\";\n\nexport default function Main() {\n  const [form, setForm] = useState({ name: \"\", phone: \"\", consent: false });\n  const requests = useEntityMutation(\"request\");\n  return (\n    <AppShell title={\"Мастерская по ремонту техники: приём, диагностика, выдача\"}>\n      <p>{\"Небольшой сервис по ремонту ноутбуков, телефонов и планшетов, два приёмщика и четыре инженера. Сейчас квитанции бумажные, клиенты звонят узнать статус. Нужна система заказов: приёмщик оформляет устройство (тип, модель, серийный номер, комплектация, внешнее состояние, неисправность со слов клиента) и печатает квитанцию с номером заказа. Клиент по номеру заказа и коду из квитанции смотрит статус на сайте без регистрации. Инженер проводит диагностику и указывает работы и запчасти с ценами; клиент получает уведомление и согласует ремонт или отказывается прямо по ссылке. Если запчасти нет, заказ ждёт поставку со сроком. Статусы: принят, диагностика, ждёт согласования, в ремонте, ждёт запчасть, готов, выдан. При выдаче фиксируем оплату на месте и гарантию 90 дней на работы. Склад запчастей: остаток и списание на заказ. Руководитель видит загрузку инженеров, просроченные заказы (дольше 14 дней) и выручку за месяц. Инженер видит только назначенные ему заказы.\"}</p>\n      <ul>\n        <li>{\"Квитанция с номером заказа\"}</li>\n        <li>{\"Статус по коду без регистрации\"}</li>\n        <li>{\"Согласование стоимости клиентом\"}</li>\n        <li>{\"Ожидание запчасти\"}</li>\n        <li>{\"Гарантия 90 дней\"}</li>\n        <li>{\"Списание запчастей со склада\"}</li>\n        <li>{\"Просроченные заказы\"}</li>\n        <li>{\"Выручка за месяц\"}</li>\n      </ul>\n      <p>{\"Ремонт не начинается без согласования клиента\"}</p>\n      <p>{\"Инженер видит только назначенные заказы\"}</p>\n      <p>{\"Клиент видит статус только своего заказа по коду\"}</p>\n      <p>{\"Заказ старше 14 дней попадает в просроченные\"}</p>\n      <form onSubmit={(e) => { e.preventDefault(); void requests.create({ contact_name: form.name, contact_phone: form.phone }, { consent: true }); }}>\n        <Field name=\"contact_name\" label=\"Имя\" type=\"string\" value={form.name} onChange={(v) => setForm({ ...form, name: String(v) })} />\n        <Field name=\"contact_phone\" label=\"Телефон\" type=\"phone\" value={form.phone} onChange={(v) => setForm({ ...form, phone: String(v) })} />\n        <ConsentCheckbox checked={form.consent} onChange={(v) => setForm({ ...form, consent: v })} />\n        <Button type=\"submit\">{\"Отправить заявку\"}</Button>\n      </form>\n    </AppShell>\n  );\n}\n"
  }
