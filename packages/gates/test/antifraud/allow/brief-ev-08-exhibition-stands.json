    "ui/Main.tsx": "import { AppShell, Button, ConsentCheckbox, Field } from \"@wizard/ui-kit\";\nimport { useEntityMutation, useState } from \"@wizard/sdk\";\n\nexport default function Main() {\n  const [form, setForm] = useState({ name: \"\", phone: \"\", consent: false });\n  const requests = useEntityMutation(\"request\");\n  return (\n    <AppShell title={\"Отраслевая выставка: бронь стендов экспонентами\"}>\n      <p>{\"Мы проводим ежегодную отраслевую выставку мебельной фурнитуры, около 80 экспонентов. Сейчас стенды продаём по переписке и путаемся, какой стенд уже занят. Нужен кабинет экспонента: компания регистрируется, заполняет карточку (название, сайт, описание для каталога выставки, логотип) и выбирает стенд на плане зала. Стенды разной площади и типа (линейный, угловой, остров), цена зависит от площади и типа. Выбранный стенд держится за экспонентом 3 дня, пока не придёт оплата через ЮKassa, затем освобождается. Дополнительно можно заказать оборудование: стулья, витрины, подключение электричества — с ценами и лимитами на складе организатора. Экспонент загружает макет оформления стенда, менеджер выставки утверждает его или возвращает с замечаниями. Каждой компании бесплатно положено 4 бейджа для стендистов, сверх лимита — платно. Организатор видит карту занятости, оплаты и неутверждённые макеты. Каталог экспонентов публикуется на сайте после оплаты. Вопросы по плану зала сейчас ведёт архитектор клиент, экспоненты пишут ей в Telegram клиент.\"}</p>\n      <ul>\n        <li>{\"План зала\"}</li>\n        <li>{\"Цена по площади и типу\"}</li>\n        <li>{\"Удержание стенда до оплаты\"}</li>\n        <li>{\"Оплата через ЮKassa\"}</li>\n        <li>{\"Лимиты оборудования\"}</li>\n        <li>{\"Утверждение макета\"}</li>\n        <li>{\"Бесплатные бейджи\"}</li>\n        <li>{\"Публичный каталог экспонентов\"}</li>\n      </ul>\n      <p>{\"Один стенд нельзя забронировать двум экспонентам\"}</p>\n      <p>{\"Неоплаченный стенд освобождается через 3 дня\"}</p>\n      <p>{\"Сверх 4 бейджей — платно\"}</p>\n      <p>{\"В каталог попадают только оплатившие экспоненты\"}</p>\n      <form onSubmit={(e) => { e.preventDefault(); void requests.create({ contact_name: form.name, contact_phone: form.phone }, { consent: true }); }}>\n        <Field name=\"contact_name\" label=\"Имя\" type=\"string\" value={form.name} onChange={(v) => setForm({ ...form, name: String(v) })} />\n        <Field name=\"contact_phone\" label=\"Телефон\" type=\"phone\" value={form.phone} onChange={(v) => setForm({ ...form, phone: String(v) })} />\n        <ConsentCheckbox checked={form.consent} onChange={(v) => setForm({ ...form, consent: v })} />\n        <Button type=\"submit\">{\"Отправить заявку\"}</Button>\n      </form>\n    </AppShell>\n  );\n}\n"
  }
