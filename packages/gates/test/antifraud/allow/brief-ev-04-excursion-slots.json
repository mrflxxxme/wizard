    "ui/Main.tsx": "import { AppShell, Button, ConsentCheckbox, Field } from \"@wizard/ui-kit\";\nimport { useEntityMutation, useState } from \"@wizard/sdk\";\n\nexport default function Main() {\n  const [form, setForm] = useState({ name: \"\", phone: \"\", consent: false });\n  const requests = useEntityMutation(\"request\");\n  return (\n    <AppShell title={\"Запись на экскурсии по слотам в рамках конференции\"}>\n      <p>{\"В последний день конференции для участников бесплатные экскурсии на три завода и в технопарк. У каждой экскурсии несколько слотов по времени, в автобусе 45 мест. Записаться могут только зарегистрированные участники конференции, не больше чем на одну экскурсию. Если мест нет — лист ожидания, и при освобождении места первый в очереди автоматически получает приглашение и должен подтвердить его за 12 часов, иначе место уходит следующему. На некоторые заводы нужны паспортные данные для пропуска — их запрашиваем только у записавшихся на эти заводы и удаляем через 7 дней после экскурсии. За день до экскурсии — напоминание в Telegram или на почту с местом и временем сбора. Сопровождающий в день экскурсии отмечает, кто пришёл.\"}</p>\n      <ul>\n        <li>{\"Вместимость слота\"}</li>\n        <li>{\"Одна экскурсия на участника\"}</li>\n        <li>{\"Лист ожидания с автоприглашением\"}</li>\n        <li>{\"Подтверждение за 12 часов\"}</li>\n        <li>{\"Паспортные данные только для отдельных заводов\"}</li>\n        <li>{\"Автоудаление паспортных данных\"}</li>\n        <li>{\"Напоминание в Telegram\"}</li>\n        <li>{\"Отметка присутствия\"}</li>\n      </ul>\n      <p>{\"Нельзя записаться сверх вместимости\"}</p>\n      <p>{\"Нельзя записаться на две экскурсии\"}</p>\n      <p>{\"При отмене первый из листа ожидания получает приглашение\"}</p>\n      <p>{\"Неподтверждённое приглашение переходит следующему\"}</p>\n      <p>{\"Паспортные данные удаляются через 7 дней\"}</p>\n      <form onSubmit={(e) => { e.preventDefault(); void requests.create({ contact_name: form.name, contact_phone: form.phone }, { consent: true }); }}>\n        <Field name=\"contact_name\" label=\"Имя\" type=\"string\" value={form.name} onChange={(v) => setForm({ ...form, name: String(v) })} />\n        <Field name=\"contact_phone\" label=\"Телефон\" type=\"phone\" value={form.phone} onChange={(v) => setForm({ ...form, phone: String(v) })} />\n        <ConsentCheckbox checked={form.consent} onChange={(v) => setForm({ ...form, consent: v })} />\n        <Button type=\"submit\">{\"Отправить заявку\"}</Button>\n      </form>\n    </AppShell>\n  );\n}\n"
