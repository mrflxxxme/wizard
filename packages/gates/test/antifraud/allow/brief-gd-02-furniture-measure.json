    "ui/Main.tsx": "import { AppShell, Button, ConsentCheckbox, Field } from \"@wizard/ui-kit\";\nimport { useEntityMutation, useState } from \"@wizard/sdk\";\n\nexport default function Main() {\n  const [form, setForm] = useState({ name: \"\", phone: \"\", consent: false });\n  const requests = useEntityMutation(\"request\");\n  return (\n    <AppShell title={\"Мебель на заказ: замер, расчёт, производство, монтаж\"}>\n      <p>{\"Мы делаем кухни и шкафы-купе на заказ. Процесс: клиент оставляет заявку на сайте и выбирает удобное время замера; менеджер назначает замерщика (у замерщиков свой график и районы). Замерщик на объекте с телефона вносит размеры помещения (ширина, высота, глубина ниш, расположение розеток и труб) и прикладывает фото. Дизайнер по замеру делает проект и смету: модули, материалы корпуса и фасадов, фурнитура, цена. Клиент согласует смету онлайн или просит правки, версий сметы может быть несколько. После согласования — договор и предоплата 70%, заказ уходит в цех со сроком изготовления. Когда готово — назначаем монтаж, монтажник закрывает заказ актом и фото. Руководитель видит воронку: заявки, замеры, согласованные сметы, в производстве, смонтировано, и выручку по месяцам. Замеры для клиентов в Лондоне согласует наш партнёр клиент, телефон клиент.\"}</p>\n      <ul>\n        <li>{\"Выбор времени замера\"}</li>\n        <li>{\"График и районы замерщиков\"}</li>\n        <li>{\"Размеры и фото с объекта\"}</li>\n        <li>{\"Версии сметы\"}</li>\n        <li>{\"Согласование сметы клиентом\"}</li>\n        <li>{\"Предоплата 70%\"}</li>\n        <li>{\"Срок изготовления\"}</li>\n        <li>{\"Акт монтажа с фото\"}</li>\n        <li>{\"Воронка и выручка\"}</li>\n      </ul>\n      <p>{\"Замерщик назначается на свободное время в своём районе\"}</p>\n      <p>{\"Заказ не уходит в производство без согласованной сметы и предоплаты\"}</p>\n      <p>{\"Сохраняется история версий сметы\"}</p>\n      <p>{\"Заказ закрывается актом монтажа\"}</p>\n      <form onSubmit={(e) => { e.preventDefault(); void requests.create({ contact_name: form.name, contact_phone: form.phone }, { consent: true }); }}>\n        <Field name=\"contact_name\" label=\"Имя\" type=\"string\" value={form.name} onChange={(v) => setForm({ ...form, name: String(v) })} />\n        <Field name=\"contact_phone\" label=\"Телефон\" type=\"phone\" value={form.phone} onChange={(v) => setForm({ ...form, phone: String(v) })} />\n        <ConsentCheckbox checked={form.consent} onChange={(v) => setForm({ ...form, consent: v })} />\n        <Button type=\"submit\">{\"Отправить заявку\"}</Button>\n      </form>\n    </AppShell>\n  );\n}\n"
  }
