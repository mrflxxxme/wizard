  "files": {
    "ui/Main.tsx": "import { AppShell, Button, ConsentCheckbox, Field } from \"@wizard/ui-kit\";\nimport { useEntityMutation, useState } from \"@wizard/sdk\";\n\nexport default function Main() {\n  const [form, setForm] = useState({ name: \"\", phone: \"\", consent: false });\n  const requests = useEntityMutation(\"request\");\n  return (\n    <AppShell title={\"Выездная стратегическая сессия для компании-заказчика\"}>\n      <p>{\"Мы агентство, организуем выездные стратегические сессии для компаний на 40–120 участников в загородных отелях. Сейчас всё в таблицах и рассылках. Нужна система на каждое мероприятие: менеджер агентства заводит мероприятие, программу по дням (пленарные блоки, работа в группах, ужин, активности) и загружает список участников, который присылает HR заказчика. Участник получает приглашение на почту, входит по ссылке и подтверждает участие, выбирает трансфер (автобус от офиса в 9:00 или своим ходом), вариант меню (обычное или вегетарианское) и одну из вечерних активностей с лимитом мест. Менеджер распределяет подтвердивших участников по номерам (двухместные, одноместные для руководителей) и по рабочим группам так, чтобы в группе были люди из разных отделов. HR заказчика видит статусы подтверждений своих сотрудников, но не видит данные других клиентов агентства. За три дня до выезда участникам уходит памятка, после сессии — анкета обратной связи с оценкой блоков программы. Отчёт для заказчика: явка, заполненность автобусов, оценки по блокам.\"}</p>\n      <ul>\n        <li>{\"Подтверждение участия\"}</li>\n        <li>{\"Выбор трансфера\"}</li>\n        <li>{\"Лимит мест на активностях\"}</li>\n        <li>{\"Распределение по номерам\"}</li>\n        <li>{\"Группы из разных отделов\"}</li>\n        <li>{\"Памятка за три дня\"}</li>\n        <li>{\"Анкета обратной связи с оценками\"}</li>\n        <li>{\"Загрузка списка участников\"}</li>\n      </ul>\n      <p>{\"HR заказчика видит только своих сотрудников\"}</p>\n      <p>{\"Нельзя выбрать активность без свободных мест\"}</p>\n      <p>{\"Неподтвердившие участники не попадают в расселение\"}</p>\n      <p>{\"Оценки блоков собираются после сессии\"}</p>\n      <form onSubmit={(e) => { e.preventDefault(); void requests.create({ contact_name: form.name, contact_phone: form.phone }, { consent: true }); }}>\n        <Field name=\"contact_name\" label=\"Имя\" type=\"string\" value={form.name} onChange={(v) => setForm({ ...form, name: String(v) })} />\n        <Field name=\"contact_phone\" label=\"Телефон\" type=\"phone\" value={form.phone} onChange={(v) => setForm({ ...form, phone: String(v) })} />\n        <ConsentCheckbox checked={form.consent} onChange={(v) => setForm({ ...form, consent: v })} />\n        <Button type=\"submit\">{\"Отправить заявку\"}</Button>\n      </form>\n    </AppShell>\n  );\n}\n"
  }
