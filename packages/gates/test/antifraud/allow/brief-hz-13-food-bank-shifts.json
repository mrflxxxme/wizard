    "ui/Main.tsx": "import { AppShell, Button, ConsentCheckbox, Field } from \"@wizard/ui-kit\";\nimport { useEntityMutation, useState } from \"@wizard/sdk\";\n\nexport default function Main() {\n  const [form, setForm] = useState({ name: \"\", phone: \"\", consent: false });\n  const requests = useEntityMutation(\"request\");\n  return (\n    <AppShell title={\"Фонд продуктовой помощи: смены волонтёров и сборка наборов\"}>\n      <p>{\"Мы небольшой благотворительный фонд: каждую неделю собираем и раздаём продуктовые наборы на четырёх точках города, помогают около 150 волонтёров. Сейчас смены собираем опросом в чате, и в субботу на одной точке десять человек, а на другой двое. Нужна система: координатор создаёт смены на точках (дата, время, задача — сортировка, фасовка, раздача, водитель) с нужным числом людей. Волонтёр входит через Telegram, видит открытые смены и записывается; записаться на заполненную смену или на две смены в одно время нельзя. Отказаться можно не позже чем за сутки, иначе только через координатора. За день до смены приходит напоминание в Telegram. Старший смены на точке отмечает, кто пришёл, и вносит, сколько наборов выдано. Склад фонда: приход продуктов от компаний-доноров и сборка наборов по шаблону, чтобы видеть, на сколько наборов хватит остатков. Получателей помощи в системе не регистрируем, выдача идёт по бумажным спискам соцслужб. Отчёт для попечителей: часы волонтёров за месяц, выдано наборов по точкам, неявки.\"}</p>\n      <ul>\n        <li>{\"Нужное число людей в смене\"}</li>\n        <li>{\"Запрет пересечения смен\"}</li>\n        <li>{\"Отказ не позже чем за сутки\"}</li>\n        <li>{\"Напоминание в Telegram\"}</li>\n        <li>{\"Отметка явки\"}</li>\n        <li>{\"Учёт выданных наборов\"}</li>\n        <li>{\"Сборка наборов по шаблону\"}</li>\n        <li>{\"Отчёт о часах волонтёров\"}</li>\n      </ul>\n      <p>{\"Нельзя записаться на заполненную смену\"}</p>\n      <p>{\"Нельзя записаться на две смены в одно время\"}</p>\n      <p>{\"Поздний отказ — только через координатора\"}</p>\n      <p>{\"Старший смены отмечает явку\"}</p>\n      <form onSubmit={(e) => { e.preventDefault(); void requests.create({ contact_name: form.name, contact_phone: form.phone }, { consent: true }); }}>\n        <Field name=\"contact_name\" label=\"Имя\" type=\"string\" value={form.name} onChange={(v) => setForm({ ...form, name: String(v) })} />\n        <Field name=\"contact_phone\" label=\"Телефон\" type=\"phone\" value={form.phone} onChange={(v) => setForm({ ...form, phone: String(v) })} />\n        <ConsentCheckbox checked={form.consent} onChange={(v) => setForm({ ...form, consent: v })} />\n        <Button type=\"submit\">{\"Отправить заявку\"}</Button>\n      </form>\n    </AppShell>\n  );\n}\n"
  }
