# Canonical list: specs/platform/deploy.yaml#local.env_vars. Placeholders only — never commit .env.
# --- db
# Local Postgres (pnpm db:up)
WIZARD_DB_URL=postgres://wizard@localhost:5433/wizard
# --- llm (provider names: specs/agents/models.yaml#providers)
# LLM mode: fixture (default, offline) | live | record
WIZARD_LLM_MODE=fixture
# Набор фикстур для fixture-режима: <suite>/<name>, например demo/forum
WIZARD_FIXTURE=demo/forum
# T0 — Cloud.ru Foundation Models (internal contour, RF)
CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1
CLOUDRU_API_KEY=
# T0 reserve — Yandex AI Studio (send x-data-logging-enabled: false)
YANDEX_BASE_URL=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# T1 — Z.ai (GLM-5.3), build calls only, PII-free
ZAI_BASE_URL=
ZAI_API_KEY=
# T1 — DeepSeek API, eval challenger only (never in default routing); optional, empty = unavailable. Default https://api.deepseek.com
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
# Build tier by default: T1 | T0 (models.yaml#week0_decision; empty = T1 until the week-0 report, F2 → T0)
WIZARD_BUILD_DEFAULT_TIER=
# Local only: fixture miss for suite=eval|unit falls through (specs/quality/eval.yaml#fixtures)
WIZARD_FIXTURE_LENIENT=
# --- auth_and_exec
WIZARD_AUTH_MODE=dev
# Local only; must fail at NODE_ENV=production
WIZARD_DEV_LOGIN=1
# Only for local M0/M1 — executes generated server code without sandbox
WIZARD_UNSAFE_LOCAL_EXEC=1
# Random 32+ bytes (e.g. `openssl rand -hex 32`)
WIZARD_PREVIEW_SECRET=
WIZARD_INTERNAL_TOKEN=
# http | https — selects runtime cookie name
WIZARD_PUBLIC_SCHEME=http
# --- platform
WIZARD_PLATFORM_ORIGIN=http://localhost:5173
# Домен систем: локально localhost (хосты <slug>--<env>.localhost:4100)
WIZARD_SYSTEMS_DOMAIN=localhost
WIZARD_RUN_CONCURRENCY=2
# Random 32 bytes, base64 — encrypts .data/secrets.enc (M1+)
WIZARD_SECRETS_KEY=
# M0 | M1 | M2 | M3 — gates skip checks with a later `since`
WIZARD_MILESTONE=M0
# 1 = send draft mail to local dev-smtp on :1025 (empty = files in .data/outbox)
WIZARD_DEV_SMTP=
# --- M1: shared platform Telegram bot (connectors/telegram.yaml)
WIZARD_TELEGRAM_BOT_TOKEN=
WIZARD_TELEGRAM_WEBHOOK_SECRET=
WIZARD_TELEGRAM_BOT_USERNAME=
# Для тестов и локальной заглушки Bot API; по умолчанию https://api.telegram.org
WIZARD_TELEGRAM_API_BASE=
# Вход через Telegram (OIDC, M1-05): база OAuth; для тестов и локальной заглушки, по умолчанию https://oauth.telegram.org.
# Секрет клиента — секрет интеграции telegram_client_secret (WIZARD_SECRET_<SCHEMAKEY>_TELEGRAM_CLIENT_SECRET)
WIZARD_TELEGRAM_OAUTH_BASE=
# Почта систем и письма платформы (OTP, приглашения, уведомления, алерты; M2-09): SMTP-аккаунт платформы
# (провайдер — решение основателя, E-ACCESS). Пусто — письма платформы пишутся в .data/outbox/platform.
# WIZARD_SMTP_TLS: implicit (465, по умолчанию) | starttls (587) | none — только локальный приёмник, не в production.
# DKIM, SPF и DMARC домена отправителя — записи DNS у провайдера (docs/ops/mail.md).
WIZARD_SMTP_HOST=
WIZARD_SMTP_PORT=465
WIZARD_SMTP_USER=
WIZARD_SMTP_PASSWORD=
WIZARD_SMTP_FROM=
WIZARD_SMTP_TLS=
# Unisender Go (*.unisender.ru): по умолчанию письма идут через HTTP API на 443, ключ = WIZARD_SMTP_PASSWORD
# (docs/ops/mail.md). WIZARD_MAIL_TRANSPORT: smtp | unisender-api; WIZARD_MAIL_API_BASE — адрес API, если не из хоста.
WIZARD_MAIL_TRANSPORT=
WIZARD_MAIL_API_BASE=
WIZARD_MAIL_DOMAIN=
# outbox (по умолчанию, письма и сообщения пишутся в .data/outbox) | live
WIZARD_CONNECTORS=outbox
# --- M2
WIZARD_RECEIPT_VAT_CODE=
WIZARD_TRUSTED_PROXIES=
# ЮKassa: база API (заглушка в тестах; по умолчанию https://api.yookassa.ru/v3) и allowlist IP вебхуков (по умолчанию — список из connectors/yookassa.yaml)
WIZARD_YOOKASSA_API_BASE=
WIZARD_YOOKASSA_IP_ALLOWLIST=
# Магазин ЮKassa самой ПЛАТФОРМЫ (подписки, докупка, привязка карты; M2-07; ключи — E-ACCESS основателя).
# Пусто — оплата в платформе недоступна. Не путать с магазинами клиентов (secret://yookassa_*)
WIZARD_PLATFORM_YOOKASSA_SHOP_ID=
WIZARD_PLATFORM_YOOKASSA_SECRET_KEY=
# Каталог с юридическими шаблонами (согласие, политика), заменяющими встроенные черновики runtime (M2-05); пусто — черновики
WIZARD_LEGAL_TEMPLATES_DIR=
# Файлы полей type=file (M2-14, runtime.yaml#files): fs (по умолчанию, папка .data/files) | memory | s3.
# В облаке — S3 в РФ (Cloud.ru Object Storage, бакет system-files, SSE-KMS); ключи доступа — E-ACCESS основателя
WIZARD_FILES_STORAGE=
WIZARD_FILES_DIR=
WIZARD_S3_ENDPOINT=
WIZARD_S3_REGION=
WIZARD_S3_BUCKET=
WIZARD_S3_ACCESS_KEY_ID=
WIZARD_S3_SECRET_ACCESS_KEY=
WIZARD_S3_KMS_KEY_ID=
# M2-06: внутренний порт runtime (health с деталями, /_wizard/internal/*, RPC песочницы; L3-19). По умолчанию PORT+1
# (локально 4101), "off" — без него. URL этого порта для platform-api (smoke публикации) и egress-прокси
WIZARD_RUNTIME_INTERNAL_PORT=
WIZARD_RUNTIME_INTERNAL_HOST=
WIZARD_RUNTIME_INTERNAL_URL=
# M3-02: ИИ-действия систем. Runtime → шлюз platform-api (POST /internal/v1/ai/run с WIZARD_INTERNAL_TOKEN), локально
# http://127.0.0.1:4000; без URL и токена кнопки ИИ отвечают 503. Фикстура ИИ-действий в fixture-режиме (<suite>/<name>)
WIZARD_PLATFORM_INTERNAL_URL=
WIZARD_AI_FIXTURE=
# Версия образа в health (в кластере — git SHA); allowlist хостов function.egress и запреты egress-прокси (L3-24)
WIZARD_VERSION=
WIZARD_EGRESS_ALLOW=
WIZARD_EGRESS_DENIED_CIDRS=
# --- Пилот (M2-15; product.yaml#decisions.D23_pilot, D24_pilot_free; deploy.yaml#pilot.env)
# Регистрация: open (по умолчанию) | invite — новый email входит только по приглашению основателя
# (pnpm --filter @wizard/platform-api pilot invite <email>) или в org; на пилоте invite
WIZARD_REGISTRATION=
# Оплата в платформе: on (по умолчанию) | off — покупка, подписки и привязка карты скрыты и отвечают 403
# PAYMENTS_DISABLED, вебхук ЮKassa выключен; на пилоте off
WIZARD_PAYMENTS=
# Платформенный лимит расходов на модели за календарный месяц (МСК), ₽; по умолчанию 6000. Достигнут — новые сборки
# и ходы интервью отклоняются (LLM_BUDGET_EXHAUSTED), при 80 % и 100 % — алерт основателю
WIZARD_LLM_MONTHLY_CAP_RUB=
# Алерты основателю: вебхук (например, sendMessage Bot API Telegram) и chat_id; пусто — только событие в логе
WIZARD_OPS_ALERT_URL=
WIZARD_OPS_ALERT_CHAT_ID=
# Те же алерты письмом (через почту платформы, M2-09); пусто — без писем
WIZARD_OPS_ALERT_EMAIL=
# Ревью основателя перед первой публикацией системы в prod и при новых полях с ПДн (orgs.require_founder_review,
# M2-09): on | off; по умолчанию on при NODE_ENV=production, иначе off
WIZARD_FOUNDER_REVIEW=
# Prometheus /metrics платформы, воркера и runtime на отдельном порту (M2-09); пусто — не слушать
WIZARD_METRICS_PORT=
WIZARD_METRICS_HOST=
# --- connector secrets in M0: WIZARD_SECRET_<SCHEMAKEY>_<NAME>=... (from M1 — secrets_refs)
